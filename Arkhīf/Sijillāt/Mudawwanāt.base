filters:
  and:
    - file.ext == "md"
    - file.folder == "Mudawwanāt"
views:
  - type: table
    name: All
    order:
      - file.name
      - file.ctime
      - tags
    sort: []
    columnSize:
      file.name: 459
  - type: table
    name: LiteratureOnThisBook
    filters:
      and:
        - list(book).contains(this)
    order:
      - chapterNumber
      - file.name
      - chapterName
    sort:
      - property: chapterNumber
        direction: ASC
    columnSize:
      note.chapterNumber: 13
      file.name: 335
      note.chapterName: 413
